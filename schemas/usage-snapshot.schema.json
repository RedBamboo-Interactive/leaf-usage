{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RedBamboo-Interactive/redleaf/main/schemas/usage/v1/usage-snapshot.schema.json",
  "title": "Usage Snapshot",
  "$ref": "#/$defs/UsageSnapshot",
  "$defs": {
    "UsageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "storyId": {
          "type": "string",
          "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
          "maxLength": 64
        },
        "storyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "period": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageSnapshotRow"
          }
        }
      },
      "required": [
        "schemaVersion",
        "snapshotId",
        "storyId",
        "storyVersion",
        "period",
        "rows"
      ]
    },
    "UsageSnapshotRow": {
      "type": "object",
      "required": [
        "dims"
      ],
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]\u002B)*$"
      },
      "properties": {
        "dims": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]\u002B)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
            "maxLength": 64
          }
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  }
}
