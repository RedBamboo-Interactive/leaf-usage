{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RedBamboo-Interactive/redleaf/main/schemas/usage/v1/usage-story.schema.json",
  "title": "Usage Story Definition",
  "$ref": "#/$defs/UsageStoryDefinition",
  "$defs": {
    "UsageDimension": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "values"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]\u002B)*$",
              "maxLength": 64
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
                "maxLength": 64
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "format"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]\u002B)*$",
              "maxLength": 64
            },
            "format": {
              "type": "string",
              "enum": [
                "release-version"
              ]
            }
          }
        }
      ]
    },
    "UsageMeasure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]\u002B)*$",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "enum": [
            "count",
            "seconds"
          ]
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "key",
        "type",
        "max"
      ]
    },
    "UsageStoryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "storyId": {
          "type": "string",
          "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shares": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "period": {
          "type": "string",
          "enum": [
            "day"
          ]
        },
        "backfillDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageDimension"
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageMeasure"
          },
          "minItems": 1
        },
        "clientObservations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "theme"
            ]
          },
          "uniqueItems": true
        },
        "introducedIn": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]\u002B)?(?:\\\u002B[0-9A-Za-z.-]\u002B)?$"
        }
      },
      "required": [
        "schemaVersion",
        "storyId",
        "version",
        "status",
        "question",
        "shares",
        "period",
        "backfillDays",
        "dimensions",
        "measures",
        "clientObservations",
        "introducedIn"
      ]
    }
  }
}
